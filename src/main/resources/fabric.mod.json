{
    "schemaVersion": 1,
    "id": "ore-amplifier",
    "version": "${version}",
    "name": "Ore Amplifier",
    "description": "Multiplies ore generation (vein count) for both Vanilla and Modded ores. Fully configurable via GameRules with dynamic detection for new ores. Part of the Instant Gratification Collection.",
    "authors": [
        "Instant Gratification"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/instant-gratification-ore-amplifier",
        "sources": "https://github.com/Rifaditya/Instant-Gratification-Ore-Amplifier",
        "issues": "https://github.com/Rifaditya/Instant-Gratification-Ore-Amplifier/issues"
    },
    "license": "GPL-3.0-or-later",
    "icon": "assets/ore-amplifier/icon.png",
    "environment": "*",
    "custom": {
        "modrinth": {
            "projectId": "41q8zP62",
            "slug": "instant-gratification-ore-amplifier"
        }
    },
    "entrypoints": {
        "main": [
            "net.instantgratification.oreamplifier.OreAmplifierFabric"
        ],
        "client": [
            "net.instantgratification.oreamplifier.OreAmplifierClient"
        ],
        "modmenu": [
            "net.instantgratification.oreamplifier.ModMenuIntegration"
        ]
    },
    "mixins": [
        "ore-amplifier.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": ">=26.2-",
        "java": ">=25",
        "fabric-api": "*",
        "dasik-library": "*"
    },
    "suggests": {
        "yet-another-config-lib": "*",
        "yet_another_config_lib_v3": "*",
        "modmenu": "*"
    }
}